# LLM key (optional for the offline planner; required for the LLM planner)
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

# MCP configuration
MCP_CONFIG=mcp_config.json
MCP_WORKSPACE=.
MCP_LOG_LEVEL=INFO
MCP_CONCURRENCY=4
MCP_MAX_FILE_MB=20
MCP_WATCH_POLL=0.5
MCP_CLIENT_TIMEOUT=60

# Bonus job-board server database
JOBS_DB=data/jobs.db
